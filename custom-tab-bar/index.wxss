.custom-tab-bar {
  position: fixed;
  z-index: 999;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 10rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(116, 142, 193, 0.08);
  border-radius: 52rpx;
  box-shadow: 0 12rpx 34rpx rgba(56, 84, 145, 0.13);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 84rpx;
  color: #a1adbf;
  border-radius: 42rpx;
}

.icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-label {
  font-size: 25rpx;
  font-weight: 620;
}

.tab-item.selected {
  color: #326bff;
}

.tab-item.selected .icon-wrap {
  background: #edf3ff;
  box-shadow: 0 7rpx 18rpx rgba(50, 107, 255, 0.15);
  transform: scale(1.04);
}

.tab-item.selected .tab-label {
  font-weight: 720;
}

@media (max-width: 380px) {
  .custom-tab-bar {
    left: 28rpx;
    right: 28rpx;
    height: 100rpx;
  }

  .tab-item {
    height: 80rpx;
  }
}
