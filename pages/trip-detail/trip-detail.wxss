@import "../../styles/glass.wxss";

.detail {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 0 calc(164rpx + env(safe-area-inset-bottom));
}

/* ---- V0.3 Room Strip：弱视觉小行，位于 header 上方，不喧宾夺主 ---- */
.room-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 32rpx 14rpx;
  padding: 10rpx 18rpx;
  background: #f6f8fc;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 20rpx;
}

.room-label {
  color: #95a1b5;
  font-size: 21rpx;
  font-weight: normal;
}

.room-code {
  color: #326bff;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.room-copy {
  flex-shrink: 0;
  margin-left: auto;
  padding: 4rpx 16rpx;
  color: #326bff;
  background: rgba(50, 107, 255, 0.08);
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.room-copy.disabled {
  color: #a5b0c2;
  background: rgba(122, 147, 194, 0.1);
}

.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx 26rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.title,
.meta {
  display: block;
}

.title {
  overflow: hidden;
  color: #17243d;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin-top: 8rpx;
  color: #8492aa;
  font-size: 23rpx;
}

/* 微信 <button> 默认样式重置：保持与 <view> 版本视觉一致 */
button::after {
  border: none;
}

.invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 20rpx 12rpx 14rpx;
  color: #326bff;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 38rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 90, 160, 0.09);
  line-height: 1.2;
  font-size: 24rpx;
  font-weight: 650;
}

.invite-btn image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
}

/* 完成行程按钮：完全沿用白色胶囊视觉，仅图标/文案/加载态不同 */
.complete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 20rpx 12rpx 14rpx;
  color: #326bff;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 38rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 90, 160, 0.09);
  line-height: 1.2;
  font-size: 24rpx;
  font-weight: 650;
}

.complete-btn image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
}

/* 请求进行中：视觉降透明 + 拦截点击（JS 层另有 IN_PROGRESS 权限兜底） */
.complete-btn.loading {
  opacity: 0.55;
  pointer-events: none;
}

/* 删除行程按钮：圆形垃圾桶图标入口，位于「完成行程」左侧。
   危险语义交给二次确认文案表达——这里只做安静的次级操作：
   与完成按钮同高同层级（白底 + 细描边 + 轻阴影），图标用低饱和蓝灰，不做红色警告视觉。 */
.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 66rpx;
  height: 66rpx;
  padding: 0;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(60, 90, 160, 0.09);
}

.delete-btn image {
  width: 34rpx;
  height: 34rpx;
}

/* 请求进行中：与完成按钮一致的降透明防重复点击态 */
.delete-btn.loading {
  opacity: 0.55;
  pointer-events: none;
}

/* ---- 分段控件：安静的浅底承载槽，选中项以白色悬浮小卡浮起，而非蓝色大色块 ---- */
.segmented {
  display: flex;
  margin: 4rpx 24rpx 24rpx;
  padding: 6rpx;
  background: #f1f4f9;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 30rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(84, 108, 155, 0.05);
}

.segment {
  box-sizing: border-box;
  flex: 1;
  width: 100%;
  margin: 0;
  padding: 16rpx 0;
  color: #8c99b0;
  background: transparent;
  border-radius: 24rpx;
  line-height: 1.4;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  transition:
    background-color 0.18s ease,
    color 0.18s ease,
    box-shadow 0.18s ease;
}

.segment.selected {
  color: #326bff;
  background: #ffffff;
  font-weight: 720;
  box-shadow:
    inset 0 0 0 1rpx rgba(50, 107, 255, 0.14),
    0 4rpx 12rpx rgba(50, 107, 255, 0.1);
}

.route-wrap {
  padding: 0 24rpx 24rpx;
}

/* ---- 「请选择出发地点」选点面板：首地点就绪但尚未选出发点时的两个入口 ---- */
.origin-picker {
  box-sizing: border-box;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.origin-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.origin-title {
  color: #17243d;
  font-size: 30rpx;
  font-weight: 750;
}

.origin-dest {
  color: #8492aa;
  font-size: 23rpx;
}

.origin-actions {
  display: flex;
  gap: 16rpx;
}

/* 两个按钮共用中性透明玻璃材质（styles/glass.wxss）：边框与阴影由 cotrip-glass--neutral 提供 */
.origin-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  color: #326bff;
  line-height: 1.35;
  font-size: 25rpx;
  font-weight: 650;
}

.origin-btn-sub {
  overflow: hidden;
  max-width: 100%;
  color: #8c99b0;
  font-size: 21rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.origin-hint {
  display: block;
  margin-top: 20rpx;
  color: #a5b0c2;
  font-size: 21rpx;
  line-height: 1.5;
}

.ideas-card {
  margin: 0 24rpx 28rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

/* 行程协调状态区：低于评论卡片一级，展示 Server authoritative 统计 + 冲突 + AI 建议 */
.coordination-card {
  margin: 0 24rpx 28rpx;
  padding: 28rpx;
  background: #f8fafd;
  border: 1rpx solid rgba(122, 147, 194, 0.12);
  border-radius: 28rpx;
}

.coordination-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.coordination-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3a55;
}

.coordination-badge {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #8a6d1a;
  background: #fdf3d7;
  border-radius: 999rpx;
}

.coordination-note {
  font-size: 22rpx;
  color: #98a2b3;
}

.coordination-stats {
  display: flex;
  margin-bottom: 20rpx;
}

.coordination-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2b3a55;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.coordination-conflict {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #9a3b3b;
  background: #fbecec;
  border-radius: 16rpx;
}

.coordination-tension {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #7a5b12;
  background: #fdf6e0;
  border-radius: 16rpx;
}

.coordination-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.row-key {
  font-size: 24rpx;
  color: #8a94a6;
}

.row-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #2b3a55;
}

.coordination-proposal {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.12);
  border-radius: 20rpx;
}

.proposal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.proposal-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #2b3a55;
}

.proposal-status {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #3b6ea5;
  background: #eaf1fb;
  border-radius: 999rpx;
}

.proposal-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #3b4a66;
}

.proposal-suggestion {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.suggestion-message {
  flex: 1;
  font-size: 22rpx;
  color: #4a5872;
}

.suggestion-confirm {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #8a6d1a;
}

.coordination-actions {
  margin-top: 16rpx;
}

.coordination-btn {
  display: inline-flex;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #3b6ea5;
  background: #eaf1fb;
  border-radius: 999rpx;
}

.coordination-btn.disabled {
  color: #98a2b3;
  background: #eef1f5;
}

.ideas-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.ideas-title {
  display: flex;
  align-items: center;
  color: #17243d;
  font-size: 32rpx;
  font-weight: 750;
}

.ideas-title image {
  width: 40rpx;
  height: 40rpx;
  margin-left: 6rpx;
}

.chat-art {
  width: 92rpx;
  height: 92rpx;
}

.comments {
  padding-top: 4rpx;
}

/* 评论输入组合：毛玻璃输入框 + 独立圆形发送按钮，二者分家并等高 */
.composer {
  position: fixed;
  z-index: 50;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

/* 输入框容器：共享无色玻璃材质，仅包裹输入框 */
.input-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 6rpx 10rpx;
  border-radius: 44rpx;
}

.input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 20rpx;
  background: #f5f7fb;
  /* 同心圆角：毛玻璃 44rpx − 上下内边距 8rpx，轮廓保持一致 */
  border-radius: 36rpx;
  font-size: 26rpx;
}

.placeholder {
  color: #b3bdcd;
}

/* 发送按钮：共享无色玻璃圆环 + 内部缩小的白色实心圆，二者同心 */
.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

/* 白色实心核心：保留原白卡 + 品牌渐变描边视觉，缩小嵌入毛玻璃环内 */
.send-btn-core {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 80rpx;
  height: 80rpx;
  background:
    linear-gradient(#ffffff, #ffffff) padding-box,
    linear-gradient(135deg, #6a5cff, #326bff 55%, #20b9ff) border-box;
  border: 2rpx solid transparent;
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(50, 107, 255, 0.12);
}

.send-btn-core image {
  width: 44rpx;
  height: 44rpx;
}

.debug-panel {
  margin: 0 24rpx 28rpx;
  overflow: hidden;
  color: #e8edfa;
  background: #26334f;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(26, 40, 73, 0.18);
}

.debug-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.debug-title {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  font-weight: 700;
}

.debug-title image {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
}

.debug-toggle {
  color: #9eabc3;
  font-size: 22rpx;
}

.debug-body {
  padding: 0 24rpx 24rpx;
}

.debug-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 24rpx;
}

.debug-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 0;
  color: #b9c3d7;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
}

.debug-row.wide {
  width: 100%;
}

.debug-subtitle {
  margin: 22rpx 0 6rpx;
  color: #7fa4ff;
  font-size: 23rpx;
  font-weight: 650;
}

.debug-query {
  max-width: 62%;
  color: #9eabc3;
  text-align: right;
  word-break: break-all;
}

.debug-constraint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 9rpx 0;
  flex-wrap: wrap;
}

.debug-tag {
  padding: 4rpx 10rpx;
  color: #dfe5f3;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 9rpx;
  font-size: 19rpx;
}

.debug-tag.hard {
  color: #ffffff;
  background: #d95665;
}

.debug-tag.soft {
  color: #ffffff;
  background: #4e7bff;
}

.debug-value {
  color: #ffffff;
  font-size: 21rpx;
}

.debug-reset {
  margin-top: 18rpx;
  padding: 14rpx 0;
  color: #ff9aa5;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 650;
}

@media (max-width: 380px) {
  .room-strip {
    margin-left: 24rpx;
    margin-right: 24rpx;
  }

  .header {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .title {
    font-size: 34rpx;
  }

  .invite-btn {
    padding-right: 14rpx;
    font-size: 22rpx;
  }

  .complete-btn {
    padding-right: 14rpx;
    font-size: 22rpx;
  }

  .delete-btn {
    width: 62rpx;
    height: 62rpx;
  }

  .delete-btn image {
    width: 32rpx;
    height: 32rpx;
  }

  .ideas-card {
    padding: 24rpx;
  }

  .input-bar {
    height: 100rpx;
  }

  .input {
    height: 84rpx;
  }

  .send-btn {
    width: 100rpx;
    height: 100rpx;
  }

  .send-btn-core {
    width: 76rpx;
    height: 76rpx;
  }

  .send-btn-core image {
    width: 42rpx;
    height: 42rpx;
  }
}
