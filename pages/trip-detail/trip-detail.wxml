<view class="detail" style="padding-bottom: {{detailBottomPadding}};">
  <view class="room-strip">
    <text class="room-label">房间号</text>
    <text class="room-code">{{roomCode}}</text>
    <view class="room-copy {{hasRoomCode ? '' : 'disabled'}}" bind:tap="onCopyRoomCode">复制</view>
  </view>

  <view class="header">
    <view class="header-info">
      <text class="title">{{trip.title}}</text>
      <text class="meta">{{participantCount}} 人参与 · {{commentCount}} 条想法</text>
    </view>
    <view wx:if="{{canDeleteTrip}}" class="delete-btn {{isDeletingTrip ? 'loading' : ''}}" bind:tap="onDeleteTripTap">
      <image src="/assets/icons/utility/trash.svg" mode="aspectFit" />
    </view>
    <view wx:if="{{canCompleteTrip}}" class="complete-btn {{isCompletingTrip ? 'loading' : ''}}" bind:tap="onCompleteTripTap">
      <image src="/assets/icons/utility/check-circle.svg" mode="aspectFit" />
      <text>{{isCompletingTrip ? '完成中…' : '完成行程'}}</text>
    </view>
  </view>

  <plan-board
    plan="{{trip.currentPlan}}"
    candidateGroups="{{candidateGroups}}"
    bind:place="onPlaceTap"
    bind:restaurant="onRestaurantTap"
  />

  <view class="segmented">
    <button class="segment" open-type="share">邀请好友</button>
    <view class="segment {{showRoute ? 'selected' : ''}}" bind:tap="onToggleRoute">我的推荐</view>
  </view>

  <view wx:if="{{showRoute}}" class="route-wrap">
    <!-- 首地点已就绪但尚未选出发地点：不自动调用，面板初开为「请选择出发地点」两个按钮 -->
    <view wx:if="{{routeNeedsOrigin}}" class="origin-picker">
      <view class="origin-head">
        <text class="origin-title">请选择出发地点</text>
        <text class="origin-dest">目的地：{{routeDestinationName}}</text>
      </view>
      <view class="origin-actions">
        <view class="origin-btn cotrip-glass cotrip-glass--neutral" bind:tap="onUseSavedDeparture">
          <text>{{savedDeparture ? '使用保存地点' : '设置出发地点'}}</text>
          <text wx:if="{{savedDeparture}}" class="origin-btn-sub">{{savedDeparture.name}}</text>
        </view>
        <view class="origin-btn cotrip-glass cotrip-glass--neutral" bind:tap="onPickDepartureOnMap">地图选点</view>
      </view>
      <text class="origin-hint">出发地点仅用于计算你的个人路线，不会公开给其他参与者</text>
    </view>
    <route-options
      wx:else
      options="{{routeOptions}}"
      expanded-index="{{expandedRouteIndex}}"
      loading="{{routeLoading}}"
      error-text="{{routeErrorText}}"
      bind:toggle="onRouteToggle"
      bind:navigate="onRouteNavigate"
      bind:retry="onRouteRetry"
    />
  </view>

  <view class="ideas-card">
    <view class="ideas-head">
      <view class="ideas-title">
        <text>大家的想法</text>
      </view>
      <image class="chat-art" src="/assets/icons/utility/chat-double.svg" mode="aspectFit" />
    </view>
    <view class="comments">
      <comment-item wx:for="{{comments}}" wx:key="id" comment="{{item}}" />
    </view>
  </view>

  <view wx:if="{{debugEnabled}}" class="debug-panel {{debugExpanded ? 'expanded' : ''}}">
    <view class="debug-header" bind:tap="onDebugToggle">
      <view class="debug-title">
        <image src="/assets/icons/settings/gear.svg" mode="aspectFit" />
        <text>Debug 面板</text>
      </view>
      <text class="debug-toggle">{{debugExpanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{debugExpanded}}" class="debug-body">
      <view class="debug-grid">
        <view class="debug-row"><text>计划版本</text><text>v{{debugPlanVersion}}</text></view>
        <view class="debug-row"><text>约束数量</text><text>{{debugConstraints.length}}</text></view>
        <view class="debug-row"><text>冲突数量</text><text>{{debugConflictCount}}</text></view>
        <view class="debug-row"><text>未解析评论</text><text>{{debugUnresolved.length}}</text></view>
      </view>
      <view class="debug-subtitle">Provider Debug</view>
      <view class="debug-row wide">
        <text>Provider</text>
        <text>{{debugProvider.provider}} {{debugProvider.configured ? '已配置' : '未配置(Seed)'}}</text>
      </view>
      <view class="debug-row wide">
        <text>Search Query</text>
        <text class="debug-query">{{debugProvider.searchQuery}}</text>
      </view>
      <view class="debug-row wide"><text>Raw Result Count</text><text>{{debugProvider.rawResultCount}}</text></view>
      <view class="debug-row wide"><text>Selected Entity</text><text>{{debugProvider.selectedEntity}}</text></view>
      <view class="debug-row wide">
        <text>ProviderRefs</text>
        <text>{{debugProvider.providerRefs.length ? debugProvider.providerRefs.join(', ') : '—'}}</text>
      </view>
      <view class="debug-row wide"><text>ExternalActions</text><text>{{debugProvider.externalActions}}</text></view>
      <view class="debug-constraints" wx:if="{{debugConstraints.length > 0}}">
        <view class="debug-subtitle">约束列表</view>
        <view wx:for="{{debugConstraints}}" wx:key="id" class="debug-constraint">
          <text class="debug-tag {{item.priority === 'HARD' ? 'hard' : 'soft'}}">{{item.priority}}</text>
          <text class="debug-tag">{{item.type}}</text>
          <text class="debug-tag">{{item.scope}}</text>
          <text class="debug-value">{{item.value.note || item.value.district || item.value.max || item.value.keyword || item.value.availableAfter || item.value.availableUntil || item.value.preference || '—'}}</text>
        </view>
      </view>
      <view class="debug-reset" bind:tap="onDebugReset">重置引擎</view>
    </view>
  </view>

  <view class="composer" style="bottom: {{composerBottom}};">
    <view class="input-bar cotrip-glass cotrip-glass--neutral">
      <input
        class="input"
        placeholder="说说你的时间、预算或想法…"
        placeholder-class="placeholder"
        value="{{inputText}}"
        bind:input="onInput"
        confirm-type="send"
        bind:confirm="onSend"
        adjust-position="{{false}}"
      />
    </view>
    <view class="send-btn cotrip-glass cotrip-glass--neutral" bind:tap="onSend">
      <view class="send-btn-core">
        <image src="/assets/icons/utility/send.svg" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>
