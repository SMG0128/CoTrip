.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  background: #ffffff;
}

.logo {
  font-size: 72rpx;
  font-weight: 800;
  color: #2f6bff;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.slogan {
  font-size: 32rpx;
  color: #1f2329;
  font-weight: 600;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.desc {
  font-size: 26rpx;
  color: #9aa0a6;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
}