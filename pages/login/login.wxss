.login {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding: 0 64rpx;
  background: #f7f9fd;
}

.login-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 420rpx;
  margin-bottom: 18rpx;
}

.login-logo {
  width: 420rpx;
  height: 420rpx;
}

.slogan {
  margin-bottom: 26rpx;
  color: #17243d;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.55;
  text-align: center;
}

.desc {
  margin-bottom: 64rpx;
  color: #8492aa;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
}

/* 微信登录按钮：白底 + 蓝描边 + 蓝字，内部一圈细腻内阴影，轻微外阴影。
   气质 = 白底蓝边现代按钮：清爽、轻盈、有层次、轻微凹陷感。 */
.login-btn {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 0;
  color: #326bff;
  background: #ffffff;
  border: 2rpx solid #326bff;
  border-radius: 48rpx;
  box-shadow:
    inset 0 2rpx 10rpx rgba(50, 107, 255, 0.1),
    0 12rpx 28rpx rgba(50, 107, 255, 0.14);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  text-align: center;
}

.login-btn::after {
  border: none;
}

.login-btn[loading] {
  opacity: 0.72;
}
