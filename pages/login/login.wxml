<view class="login">
  <view class="login-art">
    <view class="art-glow"></view>
    <image class="travel" src="/assets/3d/travel.png" mode="aspectFit" />
    <image class="star" src="/assets/3d/star.png" mode="aspectFit" />
  </view>
  <view class="logo">CoTrip</view>
  <view class="slogan">大家负责表达想法，AI 负责把想法变成共同计划。</view>

  <view class="desc">
    多人共同提出时间、地点、预算、偏好等需求，
    AI 持续维护一份可执行的共同行程计划。
  </view>

  <button class="login-btn" bind:tap="onLogin" loading="{{loading}}">
    微信登录
  </button>
</view>
