.profile {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

.user-card,
.settings-card,
.other-card {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.user-card {
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 30rpx 34rpx;
}

.user-glow {
  position: absolute;
  right: -44rpx;
  bottom: -76rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: #eef4ff;
}

.user-info {
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  margin-left: 26rpx;
}

.nickname {
  color: #17243d;
  font-size: 38rpx;
  font-weight: 760;
}

.trip-count {
  color: #8492aa;
  font-size: 24rpx;
}

.travel-art {
  z-index: 1;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.settings-card {
  margin-top: 28rpx;
  padding: 28rpx 30rpx 8rpx;
}

.settings-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  color: #17243d;
  font-size: 32rpx;
  font-weight: 750;
}

.settings-head image {
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
}

.setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 102rpx;
  border-bottom: 1rpx solid #edf1f7;
}

.setting:last-child {
  border-bottom: 0;
}

.setting-main,
.menu-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.setting-icon,
.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  background: #f3f6ff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 16rpx rgba(65, 92, 155, 0.07);
}

.setting-icon image,
.menu-icon image {
  width: 58rpx;
  height: 58rpx;
}

.setting-label {
  overflow: hidden;
  color: #27344c;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-switch {
  flex-shrink: 0;
  transform: scale(0.82);
  transform-origin: right center;
}

.other-card {
  margin-top: 28rpx;
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  color: #27344c;
  border-bottom: 1rpx solid #edf1f7;
  font-size: 27rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-arrow {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.logout .menu-main text {
  color: #e5484d;
}

@media (max-width: 380px) {
  .user-card {
    padding: 26rpx;
  }

  .travel-art {
    width: 126rpx;
    height: 126rpx;
  }

  .nickname {
    font-size: 35rpx;
  }

  .settings-card,
  .other-card {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
}
