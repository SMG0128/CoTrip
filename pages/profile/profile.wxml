<view class="profile">
  <view class="user-card">
    <view class="user-glow"></view>
    <participant-avatar nickname="{{user.nickname}}" avatarUrl="{{user.avatarUrl}}" size="124" />
    <view class="user-info">
      <text class="nickname">{{user.nickname}}</text>
      <text class="trip-count">参与过 {{tripCount}} 个行程</text>
    </view>
    <image class="travel-art" src="/assets/icons/utility/luggage-line.svg" mode="aspectFit" />
  </view>

  <view class="settings-card">
    <view class="settings-head">
      <image src="/assets/icons/utility/location.svg" mode="aspectFit" />
      <text>地点设置</text>
    </view>
    <view class="menu-item" bind:tap="onDeparturePlaces">
      <view class="menu-main">
        <view class="menu-icon"><image src="/assets/icons/utility/location.svg" mode="aspectFit" /></view>
        <text>出发设置</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="settings-card">
    <view class="settings-head">
      <image src="/assets/icons/settings/notification.svg" mode="aspectFit" />
      <text>通知设置</text>
    </view>
    <view wx:for="{{settings}}" wx:key="key" class="setting">
      <view class="setting-main">
        <view class="setting-icon"><image src="{{item.icon}}" mode="aspectFit" /></view>
        <text class="setting-label">{{item.label}}</text>
      </view>
      <switch
        class="setting-switch"
        checked="{{item.enabled}}"
        color="#326BFF"
        data-key="{{item.key}}"
        bind:change="onToggle"
      />
    </view>
  </view>

  <view class="other-card">
    <view class="menu-item" bind:tap="onEditProfile">
      <view class="menu-main">
        <view class="menu-icon"><image src="/assets/icons/trip-create/pencil.svg" mode="aspectFit" /></view>
        <text>编辑资料</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
    </view>
    <view class="menu-item" bind:tap="onPrivacy">
      <view class="menu-main">
        <view class="menu-icon"><image src="/assets/icons/settings/privacy.svg" mode="aspectFit" /></view>
        <text>隐私说明</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
    </view>
    <view class="menu-item" bind:tap="onAbout">
      <view class="menu-main">
        <view class="menu-icon"><image src="/assets/icons/settings/info.svg" mode="aspectFit" /></view>
        <text>关于 CoTrip</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="other-card">
    <view class="menu-item logout" bind:tap="onLogout">
      <view class="menu-main">
        <view class="menu-icon"><image src="/assets/icons/settings/gear.svg" mode="aspectFit" /></view>
        <text>退出登录</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>
</view>
