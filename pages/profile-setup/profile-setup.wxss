.setup {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 100vh;
  padding: 96rpx 64rpx 0;
  background: #f7f9fd;
}

/* 品牌小标：与登录页 logo 同款斜体蓝字，弱化为小尺寸 */
.brand {
  margin-bottom: 40rpx;
  color: #326bff;
  font-size: 44rpx;
  font-style: italic;
  font-weight: 850;
  letter-spacing: -2rpx;
  text-shadow: 0 6rpx 14rpx rgba(50, 107, 255, 0.16);
}

.title {
  margin-bottom: 18rpx;
  color: #17243d;
  font-size: 44rpx;
  font-weight: 750;
}

.desc {
  margin-bottom: 72rpx;
  color: #8492aa;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
}

/* 头像卡：预览圆 + 「使用微信头像」入口，视觉与表单卡同族 */
.avatar-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  padding: 30rpx 34rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.12);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

/* 预览：与 participant-avatar 同款白底渐变圆环，默认展示极简线条 SVG */
.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(145deg, #ffffff 5%, #e9f3ff 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(63, 94, 170, 0.14);
}

/* 次级操作按钮：小号胶囊、白底蓝描边，不抢主按钮层级 */
.choose-avatar-btn {
  padding: 12rpx 30rpx;
  color: #326bff;
  background: #ffffff;
  border: 2rpx solid rgba(50, 107, 255, 0.55);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.choose-avatar-btn::after {
  border: none;
}

.form-card {
  margin-top: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  padding: 26rpx 34rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.12);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.nickname-input {
  flex: 1;
  width: 100%;
  height: 56rpx;
  color: #17243d;
  font-size: 30rpx;
}

.nickname-placeholder {
  color: #a0abc0;
}

/* 主按钮：与登录页 login-btn 同款白底蓝描边 + 内阴影质感 */
.submit-btn {
  box-sizing: border-box;
  width: 100%;
  margin-top: 64rpx;
  padding: 22rpx 0;
  color: #326bff;
  background: #ffffff;
  border: 2rpx solid #326bff;
  border-radius: 48rpx;
  box-shadow:
    inset 0 2rpx 10rpx rgba(50, 107, 255, 0.1),
    0 12rpx 28rpx rgba(50, 107, 255, 0.14);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  text-align: center;
}

.submit-btn::after {
  border: none;
}

.submit-btn[loading] {
  opacity: 0.72;
}
