.home {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 0 calc(140rpx + env(safe-area-inset-bottom));
  /* 页面基底：低饱和冷灰蓝，与各模块 Surface 形成色温差 */
  background: #f5f7fc;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 170rpx;
  padding: 0 42rpx 22rpx;
  /* 方案 A：顶部纯白自然沉入极淡蓝雾，尾端完全溶解 —— 无紫色块、无边界 */
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    rgba(234, 242, 255, 0.6) 68%,
    rgba(234, 242, 255, 0) 100%
  );
}

.hero-copy {
  min-width: 0;
}

.brand-row {
  display: flex;
  align-items: flex-start;
}

.brand {
  color: #326bff;
  font-size: 62rpx;
  line-height: 1.08;
  font-style: italic;
  font-weight: 850;
  letter-spacing: -3rpx;
  text-shadow: 0 8rpx 16rpx rgba(50, 107, 255, 0.15);
}

.brand-star {
  width: 48rpx;
  height: 48rpx;
  margin: -8rpx 0 0 4rpx;
}

.tagline {
  display: block;
  margin-top: 18rpx;
  color: #8a97ae;
  font-size: 25rpx;
}

.avatar-entry {
  padding: 8rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 28rpx rgba(65, 92, 155, 0.08);
}

/* 房间码加入入口：保持纯白 Surface，靠色温差而非装饰与基底区分 */
.room-entry {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin: 0 24rpx 34rpx;
  height: 88rpx;
  padding: 0 12rpx 0 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 44rpx;
  box-shadow: 0 10rpx 26rpx rgba(60, 90, 160, 0.07);
}

.room-entry-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  opacity: 0.85;
}

.room-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #17243d;
  font-size: 27rpx;
}

.room-input-placeholder {
  color: #9dabc2;
}

.room-join {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #aab6c8;
  background: #eef1f6;
  font-size: 24rpx;
  font-weight: 650;
}

.room-join.enabled {
  color: #326bff;
  background: #e8efff;
  box-shadow: 0 6rpx 14rpx rgba(50, 107, 255, 0.16);
}

.quick {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 24rpx 38rpx;
}

.quick-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 174rpx;
  border-radius: 40rpx;
  padding: 24rpx;
}

/* 新建行程入口：白卡 + 极细品牌渐变描边（双背景层实现，圆角正常裁切）
   —— 主入口身份靠描边与图标氛围表达，而非大面积铺色 */
.quick-btn.primary {
  flex: 1.15;
  color: #326bff;
  border: 2rpx solid transparent;
  background:
    linear-gradient(#ffffff, #ffffff) padding-box,
    linear-gradient(135deg, #6a5cff, #326bff 55%, #20b9ff) border-box;
  box-shadow: 0 12rpx 28rpx rgba(50, 107, 255, 0.12);
}

/* 历史行程入口：白卡 + 更弱更安静的边框，语气退后 */
.quick-btn.secondary {
  flex: 0.85;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.07);
  box-shadow: 0 8rpx 22rpx rgba(60, 90, 160, 0.06);
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #f2f5ff;
}

/* 伪 3D 加号底座：浅蓝底圆角小胶囊 + 紧贴一圈极淡蓝色光晕，像被轻轻托起 */
.primary-icon {
  background: #eef3ff;
  border: 1rpx solid rgba(50, 107, 255, 0.16);
  box-shadow:
    0 0 0 8rpx rgba(50, 107, 255, 0.05),
    0 10rpx 22rpx rgba(50, 107, 255, 0.14);
}

/* 历史图标氛围：不改承载块形态与底色，仅加紫蓝色系小范围光晕（与新建卡同语言、更安静） */
.secondary-icon {
  box-shadow:
    0 0 0 8rpx rgba(112, 87, 255, 0.05),
    0 8rpx 20rpx rgba(112, 87, 255, 0.12);
}

.quick-icon image {
  width: 100%;
  height: 100%;
}

.quick-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.quick-title,
.quick-subtitle {
  display: block;
  white-space: nowrap;
}

.quick-title {
  color: #17243d;
  font-size: 30rpx;
  font-weight: 720;
}

.primary .quick-title {
  color: #326bff;
}

.quick-subtitle {
  margin-top: 8rpx;
  color: #8b98af;
  font-size: 21rpx;
}

.primary .quick-subtitle {
  color: #7f90b8;
}

/* 区域小标题：轻立体边框小胶囊，Surface 定为 #F0F4FF 功能蓝 */
.section-kicker {
  display: inline-flex;
  align-items: center;
  margin: 0 24rpx 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #326bff;
  background: #f0f4ff;
  border: 1rpx solid rgba(50, 107, 255, 0.2);
  box-shadow: 0 5rpx 14rpx rgba(50, 107, 255, 0.1);
  font-size: 23rpx;
  font-weight: 650;
}

.main {
  padding-top: 0;
}

.recommend {
  margin: 0 24rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.recommend-art image {
  width: 180rpx;
  height: 180rpx;
}

.rec-title {
  color: #17243d;
  font-size: 32rpx;
  font-weight: 700;
}

.rec-meta {
  margin-top: 10rpx;
  color: #8995ab;
  font-size: 24rpx;
}

.rec-action {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 32rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6a5cff, #326bff);
  font-size: 27rpx;
  font-weight: 650;
}

@media (max-width: 380px) {
  .hero {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .brand {
    font-size: 56rpx;
  }

  .quick-btn {
    padding: 20rpx;
  }

  .quick-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .quick-copy {
    margin-left: 12rpx;
  }

  .quick-title {
    font-size: 27rpx;
  }

  .quick-subtitle {
    font-size: 19rpx;
  }
}
