.home {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 0 calc(140rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 170rpx;
  padding: 0 42rpx 22rpx;
}

.hero-copy {
  min-width: 0;
}

.brand-row {
  display: flex;
  align-items: flex-start;
}

.brand {
  color: #326bff;
  font-size: 62rpx;
  line-height: 1.08;
  font-style: italic;
  font-weight: 850;
  letter-spacing: -3rpx;
  text-shadow: 0 8rpx 16rpx rgba(50, 107, 255, 0.15);
}

.brand-star {
  width: 48rpx;
  height: 48rpx;
  margin: -8rpx 0 0 4rpx;
}

.tagline {
  display: block;
  margin-top: 18rpx;
  color: #8a97ae;
  font-size: 25rpx;
}

.avatar-entry {
  padding: 8rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 28rpx rgba(65, 92, 155, 0.08);
}

.quick {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 24rpx 38rpx;
}

.quick-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 174rpx;
  border-radius: 34rpx;
  padding: 24rpx;
}

.quick-btn.primary {
  flex: 1.15;
  color: #ffffff;
  background: linear-gradient(145deg, #6674ff 0%, #326bff 58%, #20b9ff 125%);
  box-shadow: 0 16rpx 32rpx rgba(50, 107, 255, 0.25);
}

.quick-btn.secondary {
  flex: 0.85;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  box-shadow: 0 10rpx 30rpx rgba(60, 90, 160, 0.09);
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #f2f5ff;
}

.primary-icon {
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(35, 65, 163, 0.18);
}

.quick-icon image {
  width: 100%;
  height: 100%;
}

.quick-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.quick-title,
.quick-subtitle {
  display: block;
  white-space: nowrap;
}

.quick-title {
  color: #17243d;
  font-size: 30rpx;
  font-weight: 720;
}

.primary .quick-title {
  color: #ffffff;
}

.quick-subtitle {
  margin-top: 8rpx;
  color: #8b98af;
  font-size: 21rpx;
}

.primary .quick-subtitle {
  color: rgba(255, 255, 255, 0.78);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  margin: 0 24rpx 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  color: #6a5cff;
  background: #f0edff;
  font-size: 23rpx;
  font-weight: 650;
}

.main {
  padding-top: 0;
}

.recommend {
  margin: 0 24rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.recommend-art image {
  width: 180rpx;
  height: 180rpx;
}

.rec-title {
  color: #17243d;
  font-size: 32rpx;
  font-weight: 700;
}

.rec-meta {
  margin-top: 10rpx;
  color: #8995ab;
  font-size: 24rpx;
}

.rec-action {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 32rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6a5cff, #326bff);
  font-size: 27rpx;
  font-weight: 650;
}

@media (max-width: 380px) {
  .hero {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .brand {
    font-size: 56rpx;
  }

  .quick-btn {
    padding: 20rpx;
  }

  .quick-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .quick-copy {
    margin-left: 12rpx;
  }

  .quick-title {
    font-size: 27rpx;
  }

  .quick-subtitle {
    font-size: 19rpx;
  }
}
