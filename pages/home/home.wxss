@import "../../styles/glass.wxss";

.home {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 0 calc(140rpx + env(safe-area-inset-bottom));
  /* 页面基底：低饱和冷灰蓝，与各模块 Surface 形成色温差 */
  background: #f5f7fc;
}

.home-hero {
  position: relative;
}

/* 广州轮播仅是背景层：不接收触摸，所有输入与按钮保持在最高层。 */
.city-carousel-layer {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.city-carousel,
.city-carousel-image {
  width: 100%;
  height: 100%;
}

.city-carousel-image {
  opacity: 0.68;
  /* 蓝框目标比当前可见图片区约高 1/3：从顶部放大裁切，
     让城市与水面细节继续延伸到快捷按钮区域。 */
  transform: scale(1.38);
  transform-origin: center top;
}

/* 图片向下融入页面底色，避免轮播区出现硬边界。 */
.city-carousel-fade {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(245, 247, 252, 0.08) 0%,
    rgba(245, 247, 252, 0.14) 72%,
    rgba(245, 247, 252, 0.48) 90%,
    #f5f7fc 100%
  );
}

.home-hero-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

.hero {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 170rpx;
  padding: 0 42rpx 22rpx;
  background: transparent;
}

.hero-copy {
  min-width: 0;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 170rpx;
  height: 70rpx;
}

.tagline {
  display: block;
  margin-top: 18rpx;
  color: #8a97ae;
  font-size: 25rpx;
}

.avatar-entry {
  padding: 8rpx;
  border-radius: 32rpx;
}

/* 房间码加入入口：保持纯白 Surface，靠色温差而非装饰与基底区分 */
.room-entry {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin: 0 24rpx 34rpx;
  height: 88rpx;
  padding: 0 12rpx 0 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(122, 147, 194, 0.09);
  border-radius: 44rpx;
  box-shadow: 0 10rpx 26rpx rgba(60, 90, 160, 0.07);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.room-entry-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  opacity: 0.85;
}

.room-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #17243d;
  font-size: 27rpx;
}

.room-input-placeholder {
  color: #9dabc2;
}

.room-join {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #aab6c8;
  background: #eef1f6;
  font-size: 24rpx;
  font-weight: 650;
}

.room-join.enabled {
  color: #326bff;
  background: #e8efff;
  box-shadow: 0 6rpx 14rpx rgba(50, 107, 255, 0.16);
}

.quick {
  position: relative;
  z-index: 3;
  display: flex;
  gap: 20rpx;
  padding: 10rpx 24rpx 38rpx;
}

.quick-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 174rpx;
  border-radius: 40rpx;
  padding: 24rpx;
}

/* 新建行程入口：纯色白 50% 透明度填充，不再使用毛玻璃。 */
.quick-btn.primary {
  flex: 1.15;
  color: #326bff;
  border: 2rpx solid #4f7cff;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 12rpx 28rpx rgba(50, 107, 255, 0.12);
}

/* 历史行程入口：具体材质由共享无色玻璃类提供。 */
.quick-btn.secondary {
  flex: 0.85;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #f2f5ff;
}

/* 伪 3D 加号底座：浅蓝底圆角小胶囊 + 紧贴一圈极淡蓝色光晕，像被轻轻托起 */
.primary-icon {
  background: #eef3ff;
  border: 1rpx solid rgba(50, 107, 255, 0.16);
  box-shadow:
    0 0 0 8rpx rgba(50, 107, 255, 0.05),
    0 10rpx 22rpx rgba(50, 107, 255, 0.14);
}

/* 历史图标氛围：不改承载块形态与底色，仅加紫蓝色系小范围光晕（与新建卡同语言、更安静） */
.secondary-icon {
  box-shadow:
    0 0 0 8rpx rgba(112, 87, 255, 0.05),
    0 8rpx 20rpx rgba(112, 87, 255, 0.12);
}

.quick-icon image {
  width: 100%;
  height: 100%;
}

.quick-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.quick-title,
.quick-subtitle {
  display: block;
  white-space: nowrap;
}

.quick-title {
  color: #17243d;
  font-size: 30rpx;
  font-weight: 720;
}

.primary .quick-title {
  color: #326bff;
}

.quick-subtitle {
  margin-top: 8rpx;
  color: #8b98af;
  font-size: 21rpx;
}

.primary .quick-subtitle {
  color: #7f90b8;
}

/* 区域小标题：轻立体边框小胶囊，Surface 定为 #F0F4FF 功能蓝 */
.section-kicker {
  display: inline-flex;
  align-items: center;
  margin: 0 24rpx 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #326bff;
  background: #f0f4ff;
  border: 1rpx solid rgba(50, 107, 255, 0.2);
  box-shadow: 0 5rpx 14rpx rgba(50, 107, 255, 0.1);
  font-size: 23rpx;
  font-weight: 650;
}

.main {
  padding-top: 0;
}

.recommend {
  margin: 0 24rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.recommend-art image {
  width: 180rpx;
  height: 180rpx;
}

.rec-title {
  color: #17243d;
  font-size: 32rpx;
  font-weight: 700;
}

.rec-meta {
  margin-top: 10rpx;
  color: #8995ab;
  font-size: 24rpx;
}

.rec-action {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 32rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6a5cff, #326bff);
  font-size: 27rpx;
  font-weight: 650;
}

@media (max-width: 380px) {
  .hero {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .brand-logo {
    width: 154rpx;
    height: 64rpx;
  }

  .quick-btn {
    padding: 20rpx;
  }

  .quick-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .quick-copy {
    margin-left: 12rpx;
  }

  .quick-title {
    font-size: 27rpx;
  }

  .quick-subtitle {
    font-size: 19rpx;
  }
}
