<view class="home">
  <view class="hero">
    <view class="hero-copy">
      <view class="brand-row">
        <text class="brand">CoTrip</text>
        <image class="brand-star" src="/assets/3d/star.png" mode="aspectFit" />
      </view>
      <text class="tagline">AI 帮大家把想法变成共同计划</text>
    </view>
    <view class="avatar-entry" bind:tap="onProfile">
      <participant-avatar nickname="{{user.nickname}}" avatarUrl="{{user.avatarUrl}}" size="92" />
    </view>
  </view>

  <!-- 房间码加入入口：轻量搜索栏，位于 Hero 与 Quick 之间，不抢新建行程主入口 -->
  <view class="room-entry">
    <image class="room-entry-icon" src="/assets/icons/utility/link.svg" mode="aspectFit" />
    <input
      class="room-input"
      placeholder="输入房间号加入行程"
      placeholder-class="room-input-placeholder"
      value="{{roomCodeInput}}"
      bind:input="onRoomCodeInput"
      confirm-type="go"
      bind:confirm="onJoinByRoomCode"
      maxlength="16"
    />
    <view class="room-join {{roomCodeInput ? 'enabled' : ''}}" bind:tap="onJoinByRoomCode">
      加入
    </view>
  </view>

  <view class="quick">
    <view class="quick-btn primary" bind:tap="onCreateTrip">
      <view class="quick-icon primary-icon"><image src="/assets/icons/utility/plus-3d.svg" mode="aspectFit" /></view>
      <view class="quick-copy">
        <text class="quick-title">新建行程</text>
        <text class="quick-subtitle">AI 智能规划行程</text>
      </view>
    </view>
    <view class="quick-btn secondary" bind:tap="onHistory">
      <view class="quick-icon secondary-icon"><image src="/assets/icons/utility/history-line.svg" mode="aspectFit" /></view>
      <view class="quick-copy">
        <text class="quick-title">历史行程</text>
        <text class="quick-subtitle">查看过往旅程</text>
      </view>
    </view>
  </view>

  <view class="section-kicker">正在进行</view>
  <view class="main">
    <block wx:if="{{hasActiveTrips}}">
      <trip-card
        wx:for="{{activeTrips}}"
        wx:key="id"
        trip="{{item}}"
        bind:tap="onEnterTrip"
      />
    </block>

    <block wx:else>
      <view class="recommend">
        <view class="recommend-art">
          <image src="/assets/3d/travel.png" mode="aspectFit" />
        </view>
        <view class="rec-title">还没有进行中的行程</view>
        <view class="rec-meta">邀请朋友，把大家的想法变成共同计划</view>
        <view class="rec-action" bind:tap="onCreateTrip">新建第一个行程</view>
      </view>
    </block>
  </view>
</view>
