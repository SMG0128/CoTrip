<view class="create">
  <!-- 页头：轻盈的创建空间，使用 CoTrip 渐变线性图标 -->
  <view class="create-head">
    <view class="head-copy">
      <view class="head-kicker">发起一趟共同出行</view>
      <text class="head-title">创建行程</text>
      <text class="head-sub">先定范围和时间，AI 帮大家把想法变成共同计划</text>
    </view>
    <view class="head-art">
      <view class="head-glow"></view>
      <image class="head-travel" src="/assets/icons/trip-create/luggage.svg" mode="aspectFit" />
      <image class="head-star" src="/assets/icons/utility/sparkle.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 区域限定 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/area.svg" mode="aspectFit" />
      <text class="section-title">区域限定</text>
    </view>
    <view class="field" bind:tap="onAreaTap">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/location.svg" mode="aspectFit" />
        <text class="field-label">区域</text>
      </view>
      <view class="field-value">
        <text>{{areaText}}</text>
        <image class="arrow" src="/assets/icons/trip-create/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 时间范围 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/time-range.svg" mode="aspectFit" />
      <text class="section-title">时间范围</text>
    </view>
    <view class="field">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/clock.svg" mode="aspectFit" />
        <text class="field-label">开始</text>
      </view>
      <view class="field-value">
        <picker mode="date" bind:change="onStartDateChange">
          <text class="picker-text">{{startDate || '选择日期'}}</text>
        </picker>
        <picker mode="time" bind:change="onStartTimeChange">
          <text class="picker-text">{{startTime || '选择时间'}}</text>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/calendar.svg" mode="aspectFit" />
        <text class="field-label">结束</text>
      </view>
      <view class="field-value">
        <picker mode="date" bind:change="onEndDateChange">
          <text class="picker-text">{{endDate || '选择日期'}}</text>
        </picker>
        <picker mode="time" bind:change="onEndTimeChange">
          <text class="picker-text">{{endTime || '选择时间'}}</text>
        </picker>
      </view>
    </view>
  </view>

  <!-- 事件简述 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/brief.svg" mode="aspectFit" />
      <text class="section-title">事件简述</text>
    </view>
    <view class="brief-wrap">
      <image class="brief-icon" src="/assets/icons/trip-create/pencil.svg" mode="aspectFit" />
      <textarea
        class="brief"
        placeholder="例如：打两个小时羽毛球，然后去吃越南菜"
        placeholder-class="placeholder"
        value="{{brief}}"
        bind:input="onBriefInput"
        maxlength="200"
        auto-height
      />
    </view>
  </view>

  <!-- 创建 -->
  <view class="footer">
    <button class="btn-primary create-btn" bind:tap="onCreate">
      <view class="create-btn-content">
        <image class="create-btn-icon" src="/assets/icons/trip-create/calendar-plus.svg" mode="aspectFit" />
        <text>创建行程</text>
      </view>
    </button>
  </view>
</view>
