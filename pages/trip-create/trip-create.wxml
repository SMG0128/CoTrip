<view class="create">
  <!-- 页头：轻盈的创建空间，使用 CoTrip 渐变线性图标 -->
  <view class="create-head">
    <view class="head-copy">
      <view class="head-kicker">发起一趟共同出行</view>
      <text class="head-title">创建行程</text>
      <text class="head-sub">先定范围和时间，AI 帮大家把想法变成共同计划</text>
    </view>
    <view class="head-art">
      <view class="head-glow"></view>
      <image class="head-travel" src="/assets/icons/trip-create/luggage.svg" mode="aspectFit" />
      <image class="head-star" src="/assets/icons/utility/sparkle.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 行程标题 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/brief.svg" mode="aspectFit" />
      <text class="section-title">行程标题</text>
    </view>
    <view class="field">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/pencil.svg" mode="aspectFit" />
        <text class="field-label">标题</text>
      </view>
      <input
        class="title-input"
        placeholder="例如：顺德周末美食之旅"
        placeholder-class="title-placeholder"
        value="{{title}}"
        bind:input="onTitleInput"
        maxlength="100"
      />
    </view>
  </view>

  <!-- 区域限定 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/area.svg" mode="aspectFit" />
      <text class="section-title">区域限定</text>
    </view>
    <view class="field" bind:tap="onAreaTap">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/location.svg" mode="aspectFit" />
        <text class="field-label">区域</text>
      </view>
      <view class="field-value">
        <text class="{{areaMode === 'none' ? 'picker-placeholder' : 'picker-text'}}">{{areaModeText}}</text>
        <image class="arrow" src="/assets/icons/trip-create/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- 指定行政区域：国内省市区三列联动，区列首位为「不限」 -->
    <picker
      wx:if="{{areaMode === 'district'}}"
      class="field-picker"
      mode="multiSelector"
      range="{{regionColumns}}"
      value="{{regionValue}}"
      bindcolumnchange="onRegionColumnChange"
      bindchange="onRegionChange"
    >
      <view class="field">
        <view class="field-label-group">
          <image class="field-icon" src="/assets/icons/trip-create/area.svg" mode="aspectFit" />
          <text class="field-label">行政区域</text>
        </view>
        <view class="field-value">
          <text class="{{regionText ? 'picker-text' : 'picker-placeholder'}}">{{regionText || '选择省 / 市 / 区'}}</text>
          <image class="arrow" src="/assets/icons/trip-create/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
    </picker>

    <!-- 指定地点：打开微信地图选点 -->
    <view wx:elif="{{areaMode === 'location'}}" class="field" bind:tap="onChooseLocationTap">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/area.svg" mode="aspectFit" />
        <text class="field-label">地点</text>
      </view>
      <view class="field-value">
        <text class="{{locationText ? 'picker-text' : 'picker-placeholder'}}">{{locationText || '打开地图选择'}}</text>
        <image class="arrow" src="/assets/icons/trip-create/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- 指定范围：模糊定位当前位置周边 -->
    <view wx:elif="{{areaMode === 'range'}}" class="field" bind:tap="onRangeTap">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/area.svg" mode="aspectFit" />
        <text class="field-label">范围</text>
      </view>
      <view class="field-value">
        <text class="{{rangeText ? 'picker-text' : 'picker-placeholder'}}">{{rangeText || '定位当前位置'}}</text>
        <image class="arrow" src="/assets/icons/trip-create/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 时间范围 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/time-range.svg" mode="aspectFit" />
      <text class="section-title">时间范围</text>
    </view>
    <view class="field">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/clock.svg" mode="aspectFit" />
        <text class="field-label">开始</text>
      </view>
      <view class="field-value">
        <picker mode="date" bind:change="onStartDateChange">
          <text class="{{startDate ? 'picker-text' : 'picker-placeholder'}}">{{startDate || '选择日期'}}</text>
        </picker>
        <picker mode="time" bind:change="onStartTimeChange">
          <text class="{{startTime ? 'picker-text' : 'picker-placeholder'}}">{{startTime || '选择时间'}}</text>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="field-label-group">
        <image class="field-icon" src="/assets/icons/trip-create/calendar.svg" mode="aspectFit" />
        <text class="field-label">结束</text>
      </view>
      <view class="field-value">
        <picker mode="date" bind:change="onEndDateChange">
          <text class="{{endDate ? 'picker-text' : 'picker-placeholder'}}">{{endDate || '选择日期'}}</text>
        </picker>
        <picker mode="time" bind:change="onEndTimeChange">
          <text class="{{endTime ? 'picker-text' : 'picker-placeholder'}}">{{endTime || '选择时间'}}</text>
        </picker>
      </view>
    </view>
  </view>

  <!-- 事件简述 -->
  <view class="card">
    <view class="section-head">
      <image class="section-icon" src="/assets/icons/trip-create/brief.svg" mode="aspectFit" />
      <text class="section-title">事件简述</text>
    </view>
    <view class="brief-wrap">
      <image class="brief-icon" src="/assets/icons/trip-create/pencil.svg" mode="aspectFit" />
      <textarea
        class="brief"
        placeholder="例如：打两个小时羽毛球，然后去吃越南菜"
        placeholder-class="placeholder"
        value="{{brief}}"
        bind:input="onBriefInput"
        maxlength="200"
        auto-height
      />
    </view>
  </view>

  <!-- 创建 -->
  <view class="footer">
    <button class="btn-primary create-btn cotrip-glass cotrip-glass--colored" bind:tap="onCreate">
      <view class="create-btn-content">
        <image class="create-btn-icon" src="/assets/icons/trip-create/calendar-plus.svg" mode="aspectFit" />
        <text>创建行程</text>
      </view>
    </button>
  </view>
</view>
