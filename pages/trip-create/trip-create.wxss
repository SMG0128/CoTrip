.create {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 0 calc(152rpx + env(safe-area-inset-bottom));
}

/* ---- 页头：轻盈创建空间，与登录页同套伪 3D 语言 ---- */
.create-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 40rpx 36rpx;
}

.head-copy {
  flex: 1;
  min-width: 0;
}

.head-kicker {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  color: #326bff;
  background: #eef3ff;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.head-title {
  display: block;
  margin-top: 18rpx;
  color: #17243d;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.head-sub {
  display: block;
  margin-top: 10rpx;
  color: #8a97ae;
  font-size: 24rpx;
  line-height: 1.6;
}

.head-art {
  position: relative;
  flex-shrink: 0;
  width: 150rpx;
  height: 150rpx;
  margin-left: 20rpx;
}

.head-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 150rpx;
  height: 150rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(50, 107, 255, 0.12) 0%, rgba(50, 107, 255, 0) 72%);
  border-radius: 50%;
}

.head-travel {
  position: relative;
  z-index: 1;
  width: 140rpx;
  height: 140rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(50, 107, 255, 0.2));
}

.head-star {
  position: absolute;
  z-index: 2;
  top: -6rpx;
  right: 0;
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 8rpx 12rpx rgba(50, 107, 255, 0.22));
}

/* ---- 表单卡片：白色 + 圆角 + 轻描边 + 很淡外阴影（复用全局 .card） ---- */

/* 分区标题：伪 3D 小图标 + 标题，字段层级清晰 */
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-head .section-title {
  margin: 0;
}

.section-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 14rpx;
  filter: drop-shadow(0 6rpx 10rpx rgba(50, 107, 255, 0.16));
}

/* 字段：轻盈 pill 输入区，去掉重分割线 */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  margin-bottom: 16rpx;
  padding: 0 26rpx;
  background: #f8fafd;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(60, 90, 160, 0.04);
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  color: #64738d;
  font-size: 27rpx;
  font-weight: 600;
}

.field-value {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #17243d;
  font-size: 27rpx;
}

.arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.72;
}

.picker-text {
  color: #326bff;
  font-weight: 600;
}

.brief {
  box-sizing: border-box;
  width: 100%;
  min-height: 170rpx;
  padding: 24rpx;
  color: #27344c;
  background: #f8fafd;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 10rpx rgba(60, 90, 160, 0.05);
  font-size: 27rpx;
  line-height: 1.6;
}

.placeholder {
  color: #b2bdce;
}

.footer {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 249, 253, 0.96);
}

/* 创建 CTA：与登录按钮同一设计语言，作为主 CTA 使用更强一点的蓝色填充，
   但保持圆角 / 干净边界 / 克制阴影 */
.footer .btn-primary {
  margin: 0;
  border: 0;
  background: linear-gradient(135deg, #5675ff 0%, #326bff 72%);
  box-shadow: 0 12rpx 28rpx rgba(50, 107, 255, 0.26);
}

@media (max-width: 380px) {
  .create-head {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .head-title {
    font-size: 40rpx;
  }

  .head-art {
    width: 128rpx;
    height: 128rpx;
  }

  .head-travel {
    width: 120rpx;
    height: 120rpx;
  }
}
