.create {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 0 calc(152rpx + env(safe-area-inset-bottom));
}

.card {
  border-radius: 32rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  border-bottom: 1rpx solid #edf1f7;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  color: #64738d;
  font-size: 27rpx;
}

.field-value {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #17243d;
  font-size: 27rpx;
}

.arrow {
  width: 40rpx;
  height: 40rpx;
}

.picker-text {
  color: #326bff;
}

.brief {
  box-sizing: border-box;
  width: 100%;
  min-height: 170rpx;
  padding: 20rpx;
  color: #27344c;
  background: #f7f9fd;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.placeholder {
  color: #b2bdce;
}

.footer {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 249, 253, 0.96);
}

.footer .btn-primary {
  margin: 0;
  border: 0;
}
