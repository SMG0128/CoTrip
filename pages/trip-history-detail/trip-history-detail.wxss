  padding-bottom: 60rpx;
}

.sealed {
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a6;
  padding: 8rpx 0 16rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 24rpx;
}

.header-info {
  display: flex;
  flex-direction: column;
