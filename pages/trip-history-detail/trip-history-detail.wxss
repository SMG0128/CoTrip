}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
}

.meta {
  font-size: 24rpx;
  color: #9aa0a6;
}

.route-wrap {
  padding: 0 24rpx 24rpx;
}

.comments {
  padding-top: 8rpx;
}