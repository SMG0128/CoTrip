.detail {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 0 56rpx;
}

.sealed {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0 auto 20rpx;
  color: #18a979;
  font-size: 22rpx;
}

.sealed image {
  width: 36rpx;
  height: 36rpx;
}

.header {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  margin: 0 24rpx 28rpx;
  padding: 24rpx 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(60, 90, 160, 0.08);
}

.header-info {
  flex: 1;
  min-width: 0;
}

.title,
.meta {
  display: block;
}

.title {
  overflow: hidden;
  color: #17243d;
  font-size: 35rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin-top: 9rpx;
  color: #8492aa;
  font-size: 23rpx;
}

.header-art {
  width: 112rpx;
  height: 112rpx;
  margin-left: 18rpx;
}

.route-wrap {
  padding: 0 24rpx 28rpx;
}

.ideas-card {
  margin: 0 24rpx;
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.ideas-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17243d;
  font-size: 31rpx;
  font-weight: 730;
}

.ideas-head image {
  width: 76rpx;
  height: 76rpx;
}
