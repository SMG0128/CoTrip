<view class="detail">
  <view class="sealed">
    <image src="/assets/icons/status/check.svg" mode="aspectFit" />
    <text>已完成 · {{completedText}} 封存</text>
  </view>

  <view class="header">
    <view class="header-info">
      <text class="title">{{trip.title}}</text>
      <text class="meta">{{participantCount}} 人参与 · 最终计划已封存</text>
    </view>
    <image class="header-art" src="/assets/icons/utility/luggage-line.svg" mode="aspectFit" />
  </view>

  <plan-board
    plan="{{trip.currentPlan}}"
    candidateGroups="{{candidateGroups}}"
    readonly="{{true}}"
    bind:place="onPlaceTap"
    bind:restaurant="onRestaurantTap"
  />

  <view class="route-wrap">
    <personal-route route="{{route}}" segments="{{routeSegments}}" />
  </view>

  <view class="ideas-card">
    <view class="ideas-head">
      <text>大家的想法</text>
      <image src="/assets/3d/chat-bubble.png" mode="aspectFit" />
    </view>
    <view class="comments">
      <comment-item wx:for="{{comments}}" wx:key="id" comment="{{item}}" />
    </view>
  </view>
</view>
