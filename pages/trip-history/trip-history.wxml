<view class="history">
  <view class="history-hero">
    <view>
      <text class="hero-title">旅程回忆</text>
      <text class="hero-subtitle">每一次共同决定，都值得好好收藏</text>
    </view>
    <image src="/assets/3d/travel.png" mode="aspectFit" />
  </view>
  <view class="list">
    <trip-card
      wx:for="{{trips}}"
      wx:key="id"
      trip="{{item}}"
      history="{{true}}"
      data-trip-id="{{item.id}}"
      bind:tap="onTripTap"
    />
  </view>
</view>
