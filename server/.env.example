# CoTrip Backend V0.1 — 环境变量示例
# 复制为 .env 并填入真实值。切勿提交真实凭据。

# 微信小程序 AppID（在微信公众平台获取）
WECHAT_APPID=

# 微信小程序 AppSecret（在微信公众平台获取，仅后端持有）
WECHAT_SECRET=

# 用于签发 CoTrip 应用 token 的密钥（任意足够长的随机字符串）
AUTH_TOKEN_SECRET=

# 后端监听端口
PORT=3000

# 评论 AI：OpenAI-compatible Chat Completions。三项齐全才启用。
# Key 仅保存在 server/.env，绝不能写入小程序或提交到 Git。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

# 评论 AI：CloudBase HTTP Function 网关（AI_PROVIDER=cloudbase_gateway 时启用）。
# 链路：CoTrip Server → CloudBase HTTP Function → hunyuan-v3 (hy3)。
# AI_GATEWAY_SECRET 与云函数环境变量 COTRIP_AI_GATEWAY_SECRET 一致。
AI_PROVIDER=
AI_GATEWAY_URL=
AI_GATEWAY_SECRET=

# 腾讯位置服务 WebService Key（服务端 POI 解析 / 附近餐厅搜索）。
# 与前端 config/tencent-map.ts 是同一个腾讯 Key，仅服务端通过 env 注入。
# 绝不硬编码、绝不打印、绝不提交真实值到 Git。
TENCENT_MAP_KEY=
