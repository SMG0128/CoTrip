.comment {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.comment:last-child {
  border-bottom: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.nickname {
  min-width: 0;
  color: #17243d;
  font-size: 27rpx;
  font-weight: 700;
}

.status-slot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 170rpx;
}

.text {
  display: block;
  color: #64738d;
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}

.coverage-note {
  margin-top: 10rpx;
  color: #6b7ea8;
  font-size: 23rpx;
}
