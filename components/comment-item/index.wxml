<view class="comment">
  <participant-avatar nickname="{{nickname}}" avatarUrl="{{avatarUrl}}" size="76" />
  <view class="comment-main">
    <view class="head">
      <text class="nickname">{{nickname}}</text>
      <view class="status-slot">
        <constraint-status status="{{comment.aiStatus}}" />
      </view>
    </view>
    <text class="text">{{comment.rawText}}</text>
    <view
      wx:if="{{comment.intentCoverage && comment.intentCoverage.incorporation === 'PARTIALLY_INCORPORATED'}}"
      class="coverage-note"
    >
      已加入 {{comment.intentCoverage.plannedCount}} / {{comment.intentCoverage.totalCount}} 项
    </view>
  </view>
</view>
