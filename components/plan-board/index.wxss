.board {
  background: linear-gradient(180deg, #2f6bff 0%, #2456d6 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  color: #ffffff;
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.board-title {
  font-size: 36rpx;
  font-weight: 700;
}

.version {
  font-size: 22rpx;
  opacity: 0.7;
}

.events {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.restaurant {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.restaurant:last-child {
  border-bottom: none;
}

.r-name {
  font-size: 28rpx;
}

.r-meta {
  font-size: 26rpx;
  opacity: 0.9;
}

.total {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.satisfied {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.conflict {
  margin-top: 24rpx;
  background: rgba(229, 72, 77, 0.25);
  border-radius: 16rpx;
  padding: 20rpx;
}

.conflict-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.conflict-item {
  font-size: 24rpx;
  opacity: 0.95;
  line-height: 1.5;
}