.board {
  box-sizing: border-box;
  margin: 0 24rpx 28rpx;
  padding: 30rpx;
  color: #17243d;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.board-head {
  margin-bottom: 18rpx;
}

.title-wrap {
  display: flex;
  align-items: center;
}

.ai-mark,
.board-title {
  font-size: 33rpx;
  font-weight: 750;
}

.ai-mark {
  margin-right: 10rpx;
  color: #4f61f6;
}

.board-title {
  color: #17243d;
}

.version {
  padding: 8rpx 18rpx;
  color: #6a5cff;
  background: #f0edff;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 650;
}

.events {
  padding: 0 18rpx;
  background: #fbfcff;
  border: 1rpx solid #f0f4fa;
  border-radius: 28rpx;
}

.date-header {
  padding: 22rpx 0 2rpx;
  color: #a8b3c7;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 交通路线段：低一级辅助节点，位于两个活动之间。
   只显示文字，无图标、无卡片、无背景块、无与 Activity 同级的大圆点；
   文本靠近时间轴（活动竖线同一列右侧），不遮挡竖线。 */
.route-node {
  display: grid;
  grid-template-columns: 28rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 4rpx 0;
}

.route-rail {
  position: relative;
}

.route-rail-line {
  position: absolute;
  top: 0;
  bottom: -30rpx;
  left: 50%;
  width: 3rpx;
  background: #dce7fa;
  transform: translateX(-50%);
}

.route-text {
  display: block;
  color: #a8b3c7;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.5;
}

.budget-summary {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx;
  background: #f9fbff;
  border: 1rpx solid #eef3fb;
  border-radius: 28rpx;
}

.wallet {
  width: 82rpx;
  height: 82rpx;
  margin-right: 18rpx;
}

.budget-copy {
  flex: 1;
  min-width: 0;
}

.budget-title,
.satisfied,
.total {
  display: block;
}

.budget-title {
  color: #17243d;
  font-size: 25rpx;
  font-weight: 700;
}

.satisfied {
  margin-top: 6rpx;
  color: #326bff;
  font-size: 22rpx;
}

.total {
  margin-top: 4rpx;
  color: #8995ab;
  font-size: 21rpx;
}

.tick {
  width: 64rpx;
  height: 64rpx;
}

.conflict {
  margin-top: 20rpx;
  padding: 20rpx;
  color: #c34a56;
  background: #fff0f2;
  border-radius: 22rpx;
}

.conflict-title {
  font-size: 25rpx;
  font-weight: 650;
}

.conflict-item {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

@media (max-width: 380px) {
  .board {
    padding: 24rpx;
  }

  .events {
    padding: 0 10rpx;
  }

  .route-node {
    grid-template-columns: 24rpx minmax(0, 1fr);
    gap: 12rpx;
  }
}
