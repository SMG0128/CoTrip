.restaurant {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #2f6bff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4e5969;
}

.arrow {
  color: #c9cdd4;
  font-size: 40rpx;
}