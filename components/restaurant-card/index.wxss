.restaurant {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #4e7bff, #20b9ff);
  color: #ffffff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #17243d;
}

.meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #64738d;
}

.arrow {
  width: 40rpx;
  height: 40rpx;
}
