<view class="restaurant" bind:tap="onTap">
  <view class="rank">{{index + 1}}</view>
  <view class="info">
    <text class="name">{{restaurant.name}}</text>
    <view class="meta">
      <price-display price="{{restaurant.averagePrice}}" />
      <text wx:if="{{restaurant.rating}}"> · {{restaurant.rating.score}}</text>
    </view>
  </view>
  <image class="arrow" src="/assets/icons/utility/chevron-right.svg" mode="aspectFit" />
</view>
