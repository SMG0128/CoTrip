.route {
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(60, 90, 160, 0.08);
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #17243d;
}

.departure {
  font-size: 26rpx;
  color: #326bff;
  font-weight: 600;
}

.steps {
  padding-left: 8rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 28rpx;
}

.step:last-child {
  padding-bottom: 0;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #326bff;
  margin: 10rpx 20rpx 0 0;
  flex-shrink: 0;
}

.step:not(:last-child) .step-dot::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 30rpx;
  width: 2rpx;
  height: 100%;
  background: #dce7fa;
}

.step-info {
  display: flex;
  flex-direction: column;
}

.step-label {
  font-size: 28rpx;
  color: #27344c;
  font-weight: 500;
}

.step-action {
  font-size: 24rpx;
  color: #8492aa;
}

.foot {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f7;
  font-size: 26rpx;
  color: #64738d;
}

.price {
  display: flex;
  align-items: center;
}
