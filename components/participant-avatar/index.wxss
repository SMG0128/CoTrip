.avatar {
  border-radius: 50%;
  background: linear-gradient(145deg, #ffffff 5%, #e9f3ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(63, 94, 170, 0.14);
}

.img {
  width: 100%;
  height: 100%;
}
