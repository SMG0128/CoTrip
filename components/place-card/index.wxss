.place {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.pin {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.sub {
  font-size: 24rpx;
  color: #9aa0a6;
}

.arrow {
  color: #c9cdd4;
  font-size: 40rpx;
}