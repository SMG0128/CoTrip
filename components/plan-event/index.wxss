.event {
  position: relative;
  display: grid;
  grid-template-columns: 28rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 20rpx 0;
}

.rail {
  position: relative;
  display: flex;
  justify-content: center;
}

.dot {
  z-index: 1;
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border: 6rpx solid #e7efff;
  border-radius: 50%;
  background: #76a6ff;
}

.line {
  position: absolute;
  top: 40rpx;
  bottom: -30rpx;
  width: 3rpx;
  background: #dce7fa;
}

.event-body {
  min-width: 0;
}

.event-main {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  gap: 16rpx;
  min-height: 146rpx;
}

.event-art {
  align-self: center;
  width: 112rpx;
  height: 112rpx;
}

.event-art image {
  width: 100%;
  height: 100%;
}

.info {
  align-self: center;
  min-width: 0;
}

.time,
.title,
.loc,
.address,
.selected-label,
.candidate-name {
  display: block;
}

.time {
  margin-bottom: 8rpx;
  color: #326bff;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  color: #17243d;
  font-size: 31rpx;
  font-weight: 720;
}

.selected-label {
  margin-top: 8rpx;
  color: #6a5cff;
  font-size: 18rpx;
  font-weight: 650;
}

.loc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #7787a3;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-line,
.entity-meta {
  margin-top: 5rpx;
  color: #9aa6bb;
  font-size: 20rpx;
}

.address-line {
  display: flex;
  align-items: flex-start;
  gap: 4rpx;
  line-height: 1.45;
}

.address-pin {
  flex-shrink: 0;
}

.address {
  min-width: 0;
  overflow-wrap: anywhere;
}

.entity-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
}

.event-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.event-rating image {
  width: 24rpx;
  height: 24rpx;
}

.selected-over-budget {
  padding: 4rpx 8rpx;
  color: #b56f00;
  background: #fff2d7;
  border-radius: 12rpx;
  font-size: 17rpx;
}

.event-distance {
  color: #8a96aa;
  font-size: 20rpx;
}

.route-line {
  margin: 8rpx 0 4rpx;
  color: #8a96aa;
  font-size: 20rpx;
}

.route-label {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 10rpx;
  background: #eef2f8;
  border-radius: 12rpx;
}

.candidate-tray {
  margin: 8rpx 0 4rpx;
  overflow: hidden;
  background: #eef2f8;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(70, 90, 130, 0.06);
}

.candidate-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 0 18rpx;
  color: #65738d;
  font-size: 21rpx;
  font-weight: 600;
}

.candidate-toggle image {
  width: 30rpx;
  height: 30rpx;
}

.candidate-list {
  padding: 0 14rpx 10rpx;
}

.candidate-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 8rpx 4rpx;
  border-top: 1rpx solid rgba(130, 149, 180, 0.12);
}

.candidate-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  color: #65738d;
  background: #ffffff;
  border-radius: 50%;
  font-size: 19rpx;
  font-weight: 700;
}

.candidate-copy {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  overflow: hidden;
  color: #47556e;
  font-size: 21rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 4rpx;
  color: #8a96aa;
  font-size: 18rpx;
}

.over-budget {
  margin-left: 8rpx;
  padding: 5rpx 8rpx;
  color: #b56f00;
  background: #fff2d7;
  border-radius: 12rpx;
  font-size: 17rpx;
  white-space: nowrap;
}

.candidate-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
}

@media (max-width: 380px) {
  .event {
    grid-template-columns: 24rpx minmax(0, 1fr);
    gap: 12rpx;
  }

  .event-main {
    grid-template-columns: 92rpx minmax(0, 1fr);
    gap: 12rpx;
  }

  .event-art {
    width: 92rpx;
    height: 92rpx;
  }

  .title {
    font-size: 28rpx;
  }

  .candidate-name {
    font-size: 20rpx;
  }
}
