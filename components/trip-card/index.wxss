.trip {
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid rgba(122, 147, 194, 0.08);
  border-radius: 36rpx;
  margin: 0 24rpx 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 90, 160, 0.09);
}

/* 进行中卡片：纯白主卡，仅左上角一团极淡蓝色光斑增加呼吸感 —— 整体仍被感知为白卡 */
.active-trip {
  padding: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(42% 34% at 12% 0%, rgba(50, 107, 255, 0.06), rgba(50, 107, 255, 0) 100%),
    #ffffff;
  border-color: rgba(122, 147, 194, 0.09);
  box-shadow: 0 14rpx 38rpx rgba(60, 90, 160, 0.11);
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f0edff;
  color: #6a5cff;
  font-size: 23rpx;
  font-weight: 650;
}

/* 进行中胶囊：与首页「正在进行」标签、「进入行程」操作条同一套伪 3D 边框语言
   （仅作用于进行中卡片，历史卡「已完成」胶囊保持原样） */
.active-trip .status {
  padding: 8rpx 20rpx;
  color: #326bff;
  background: linear-gradient(180deg, #ffffff, #f6f9ff);
  border: 1rpx solid rgba(50, 107, 255, 0.2);
  box-shadow:
    inset 0 2rpx 5rpx rgba(255, 255, 255, 0.85),
    inset 0 -3rpx 7rpx rgba(50, 107, 255, 0.05),
    0 5rpx 14rpx rgba(50, 107, 255, 0.1);
}

/* 状态标记：主蓝描边空心圆环 —— 告别「在线状态灯」语义，融入 CoTrip 蓝紫描边语言 */
.status-dot {
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #326bff;
  border-radius: 50%;
  background: transparent;
  box-shadow: 0 2rpx 5rpx rgba(50, 107, 255, 0.18);
}

.trip-head {
  display: flex;
  align-items: center;
}

.trip-copy {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  color: #17243d;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 760;
}

.stats {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  color: #7f8da8;
  font-size: 23rpx;
  white-space: nowrap;
}

.stats-divider {
  width: 1rpx;
  height: 22rpx;
  background: #dce3ef;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 0 10rpx;
}

.empty-art {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: #eef3ff;
  border: 1rpx solid rgba(50, 107, 255, 0.14);
  box-shadow: 0 10rpx 22rpx rgba(50, 107, 255, 0.12);
}

.empty-art image {
  width: 100%;
  height: 100%;
}

.empty-title {
  margin-top: 24rpx;
  color: #17243d;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8995ab;
  font-size: 23rpx;
}

.schedule {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #f8faff;
  box-shadow: inset 0 0 0 1rpx rgba(113, 143, 204, 0.07);
}

.schedule-event {
  flex: 1;
  min-width: 0;
}

.schedule-time {
  display: block;
  margin-bottom: 12rpx;
  color: #326bff;
  font-size: 26rpx;
  font-weight: 700;
}

.event-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.event-main image {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.event-copy {
  min-width: 0;
}

.event-title,
.event-place {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-title {
  color: #17243d;
  font-size: 27rpx;
  font-weight: 650;
}

.event-place {
  margin-top: 5rpx;
  color: #8995ab;
  font-size: 21rpx;
}

.schedule-arrow {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.conflict-hint {
  margin-top: 18rpx;
  color: #ef6c78;
  font-size: 23rpx;
}

/* 进入行程主操作条：白底为主 + 极轻蓝白渐变边缘感，层次靠细描边而非铺色 */
.enter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  color: #326bff;
  background: linear-gradient(180deg, #ffffff, #f9fbff);
  border: 1rpx solid rgba(50, 107, 255, 0.28);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.9),
    0 8rpx 20rpx rgba(50, 107, 255, 0.12);
  font-size: 28rpx;
  font-weight: 700;
}

.enter image {
  width: 44rpx;
  height: 44rpx;
}

.row-arrow {
  width: 48rpx;
  height: 48rpx;
}

.history-trip {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.history-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: #f4f6ff;
  margin-right: 24rpx;
}

.history-icon image {
  width: 100%;
  height: 100%;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.history-trip .title {
  flex: 1;
  font-size: 31rpx;
}

.status.completed {
  color: #18a979;
  background: #e9fbf4;
  white-space: nowrap;
}

.meta {
  display: flex;
  gap: 18rpx;
  margin-top: 12rpx;
  color: #8995ab;
  font-size: 23rpx;
}

@media (max-width: 380px) {
  .stats {
    gap: 8rpx;
    font-size: 21rpx;
  }
}
